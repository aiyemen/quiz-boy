# Telegram Bot API Token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# Database Connection URL (PostgreSQL for Production, SQLite for Local Dev)
# Production: postgresql+asyncpg://postgres:password@db:5432/quizbot
# Development: sqlite+aiosqlite:///./quizbot.db
DATABASE_URL=sqlite+aiosqlite:///./quizbot.db

# Environment Mode: development | staging | production
ENVIRONMENT=development

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Maximum batch question limit for Quick Create
MAX_BATCH_QUESTIONS=100

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=60

# Optional Webhook Configuration (leave empty for Long Polling)
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
